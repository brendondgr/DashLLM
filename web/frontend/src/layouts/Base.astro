---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      body { margin: 0; background: #0B0E14; color-scheme: dark; }
      * { box-sizing: border-box; }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb { background: #242C3A; border-radius: 6px; border: 2px solid #0B0E14; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::selection { background: rgba(255, 178, 36, .25); }
      @keyframes livepulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
      @keyframes rowstream { 0%, 100% { background: rgba(88, 196, 221, .05); } 50% { background: rgba(88, 196, 221, .12); } }
      @keyframes spin { to { transform: rotate(360deg); } }
      /* hover states ported from the prototype's style-hover attributes */
      .hv-bg:hover { background: #161C28 !important; color: #E6EAF2 !important; }
      .hv-border:hover { border-color: #3A4A63 !important; }
      .hv-text:hover { color: #E6EAF2 !important; }
      .hv-row:hover { background: #1A2233 !important; }
      .hv-rowdark:hover { background: #151B27 !important; }
      .hv-bright:hover { filter: brightness(1.1); }
      .hv-under:hover { text-decoration: underline; }
      .hv-accent:hover { border-color: #FFB224 !important; color: #FFB224 !important; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
