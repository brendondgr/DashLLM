[Unit]
Description=DashLLM relay - OpenAI-compatible LLM proxy + dashboard
# Start after the local model server and the remote vLLM tunnel so the
# endpoint pool is reachable quickly. These are ordering/intent hints only:
# relay tolerates a down endpoint (health probes + failover), so it still
# starts and serves the dashboard if a model server is unavailable.
After=network-online.target llamacpp-router.service vllm-tunnel-skynet.service
Wants=network-online.target vllm-tunnel-skynet.service

[Service]
Type=simple
WorkingDirectory=%h/Tools/DashLLM/web/backend
# uv resolves the project venv from the pyproject.toml in WorkingDirectory.
ExecStart=/usr/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 4000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Persist runtime state (registered endpoints, telemetry) under the repo.
Environment=RELAY_DB_PATH=%h/Tools/DashLLM/web/backend/data/relay.db
Environment=RELAY_LOG_DIR=%h/Tools/DashLLM/web/backend/logs

[Install]
WantedBy=default.target
