[Unit]
Description=DashLLM relay - OpenAI-compatible LLM proxy + dashboard
# relay comes up on boot and serves the dashboard + proxy. It does NOT connect
# any SSH tunnel on its own: tunnel-backed endpoints (e.g. skynet) are connected
# manually from the Endpoints screen, where prompts are answered interactively.
# We only order after the local model server so its endpoint is reachable
# quickly; relay tolerates a down endpoint via health probes + failover.
After=network-online.target llamacpp-router.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Tools/DashLLM/web/backend
# uv resolves the project venv from the pyproject.toml in WorkingDirectory.
ExecStart=/usr/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 4000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Persist runtime state (registered endpoints, telemetry) under the repo.
Environment=RELAY_DB_PATH=%h/Tools/DashLLM/web/backend/data/relay.db
Environment=RELAY_LOG_DIR=%h/Tools/DashLLM/web/backend/logs
# Same .env launch.sh reads, so the service and the script agree on
# RELAY_REQUIRE_CLIENT_KEY / RELAY_ADMIN_TOKEN. Leading `-` = optional.
# Note: ExecStart's --port above is fixed; RELAY_PORT in .env does not move it.
EnvironmentFile=-%h/Tools/DashLLM/.env

[Install]
WantedBy=default.target
