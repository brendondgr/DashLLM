# DashLLM launch configuration. Copy to `.env` and edit; `.env` is gitignored.
#
#   cp .env.example .env && ./launch.sh
#
# Read by ./launch.sh (via `set -a; source`) and, if you install the systemd
# unit, by relay.service (via EnvironmentFile). Keep the syntax to the subset
# both understand: KEY=value, no `export`, no $VAR expansion, no inline
# comments after a value. Quote any value containing spaces.

# ---- relay ---------------------------------------------------------------
RELAY_PORT=4000

# Bind address. 127.0.0.1 keeps relay reachable only from this machine.
# 0.0.0.0 exposes it to your whole network — if you set that, set
# RELAY_REQUIRE_CLIENT_KEY=1 as well, and understand that an OpenCode endpoint
# behind an unauthenticated relay is a remote shell for anyone on the LAN.
RELAY_HOST=127.0.0.1

# The key YOUR clients send to relay as `Authorization: Bearer ...`.
# Leave empty and relay generates one on first boot and keeps it in its DB
# (launch.sh prints it). Set it to pin a known value instead — useful when the
# key has to be baked into client configs ahead of time. This is relay's own
# key; it has nothing to do with the provider keys at the bottom of this file.
RELAY_API_KEY=

# Require clients to send the relay API key as a Bearer token on /v1/*.
# Strongly recommended whenever an agent endpoint is registered: OpenCode runs
# shell commands on its host, so an open relay in front of one is an open
# remote shell. launch.sh prints the key on startup.
RELAY_REQUIRE_CLIENT_KEY=1

# Optional: require X-Admin-Token on /admin/*. Leave empty for localhost use.
RELAY_ADMIN_TOKEN=

# ---- opencode ------------------------------------------------------------
# Set to 0 to launch relay on its own.
OPENCODE_ENABLED=1
OPENCODE_PORT=4096

# HTTP Basic credentials the server will demand and relay will present.
# A password is required; without one `opencode serve` accepts anyone who can
# reach the port.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# The project the agent works in. `opencode serve` is bound to one directory —
# its bash/edit/write tools act here. Defaults to this repo, which is rarely
# what you want; point it at the project you actually want the agent driving.
OPENCODE_PROJECT_DIR=

# How the endpoint appears in relay. OPENCODE_ALIAS is the routing name
# clients send as "model" to reach the agent.
OPENCODE_ENDPOINT_NAME=opencode
OPENCODE_ALIAS=agent

# Models this endpoint may serve, comma-separated, as `provider/model`.
# Each becomes individually addressable: clients can send
# "model": "anthropic/claude-sonnet-4-5" and get exactly that. Leave empty to
# serve only the alias, on whatever model OpenCode defaults to.
# Run `./launch.sh --list-models` to see what your server offers.
OPENCODE_MODELS=

# ---- provider API keys (what OpenCode uses to reach the models) ----------
# launch.sh exports these into the `opencode serve` process, so a key set here
# is the key that provider authenticates with. This is the alternative to
# running `opencode auth login` — either works; a key here wins for that
# provider and needs no interactive login, which is what you want on a server.
#
# Which one you need depends on the providers in your opencode config.
# `./launch.sh --list-models` lists them by provider id:
#   opencode/...    -> OPENCODE_API_KEY   (OpenCode Zen)
#   anthropic/...   -> ANTHROPIC_API_KEY
#   openai/...      -> OPENAI_API_KEY
# A locally-hosted provider (e.g. your own vLLM) usually needs no key at all.
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
