#!/usr/bin/env bash
# relay — control the DashLLM relay systemd *user* service from anywhere.
#
#   relay start | stop | restart | status | logs | enable | disable
#
# Controls the OpenCode agent server alongside relay when opencode.service is
# installed (systemd handles the propagation; see deploy/systemd/). Add
# --relay-only to any command to leave the agent server alone.
#
# Install (user-wide, on PATH):
#   install -m755 scripts/relay ~/.local/bin/relay
# or system-wide (all users, needs sudo):
#   sudo install -m755 scripts/relay /usr/local/bin/relay
set -euo pipefail

UNIT=relay.service
OC_UNIT=opencode.service
REPO="$HOME/Tools/DashLLM"

usage() {
  cat <<EOF
relay — control the DashLLM relay service (+ the OpenCode agent server)

  relay start      start relay (and opencode)
  relay stop       stop relay (and opencode)
  relay restart    restart both (e.g. after a code change)
  relay status     show service status + health for both
  relay logs       follow the logs of both (Ctrl-C to quit)
  relay enable     start on boot (enable + linger)
  relay disable    don't start on boot

  --relay-only     act on relay.service alone, leaving opencode running
EOF
}

# --relay-only can appear anywhere; strip it out before reading the verb.
RELAY_ONLY=0
args=()
for a in "$@"; do
  case "$a" in
    --relay-only) RELAY_ONLY=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]:-status}"

# The agent server is in play only when its unit is installed, it is not
# switched off in .env, and the caller didn't opt out.
oc_active() {
  [ "$RELAY_ONLY" -eq 0 ] || return 1
  systemctl --user list-unit-files "$OC_UNIT" >/dev/null 2>&1 || return 1
  [ -f "$HOME/.config/systemd/user/$OC_UNIT" ] || return 1
  if [ -f "$REPO/.env" ] && grep -qE '^OPENCODE_ENABLED=0' "$REPO/.env"; then
    return 1
  fi
  return 0
}

units() {
  if oc_active; then echo "$UNIT $OC_UNIT"; else echo "$UNIT"; fi
}

relay_port() {
  local port=4000
  if [ -f "$REPO/.env" ]; then
    local from_env
    from_env=$(grep -E '^RELAY_PORT=' "$REPO/.env" | tail -1 | cut -d= -f2 | tr -d '"' | tr -d "'")
    [ -n "$from_env" ] && port="$from_env"
  fi
  echo "$port"
}
PORT="$(relay_port)"

# Re-apply .env to relay's endpoint registry. Best effort: a failure here means
# the endpoint is stale, not that relay is down, so it must not fail the verb.
register_endpoint() {
  oc_active || return 0
  [ -f "$REPO/.env" ] || return 0
  [ -f "$REPO/scripts/register_opencode.py" ] || return 0
  for _ in $(seq 1 40); do
    curl -fsS --max-time 2 "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1 && break
    sleep 0.5
  done
  # Wait for the agent server too, not just relay: registering while opencode
  # is still booting records the endpoint as `degraded` on the create-time
  # probe. It self-heals on the next 15s sweep, but "degraded" is a poor first
  # thing to print after a successful start.
  local oc_port oc_user oc_pass
  oc_port=$(. "$REPO/.env" >/dev/null 2>&1; echo "${OPENCODE_PORT:-4096}")
  oc_user=$(. "$REPO/.env" >/dev/null 2>&1; echo "${OPENCODE_SERVER_USERNAME:-opencode}")
  oc_pass=$(. "$REPO/.env" >/dev/null 2>&1; echo "${OPENCODE_SERVER_PASSWORD:-}")
  for _ in $(seq 1 40); do
    curl -fsS --max-time 2 -u "${oc_user}:${oc_pass}" \
      "http://127.0.0.1:${oc_port}/global/health" >/dev/null 2>&1 && break
    sleep 0.5
  done
  ( set -a; . "$REPO/.env"; set +a
    python3 "$REPO/scripts/register_opencode.py" ) 2>&1 | sed 's/^/  /' || true
}

case "${1:-status}" in
  start)
    # shellcheck disable=SC2046
    systemctl --user start $(units) && echo "started: $(units)"
    register_endpoint
    ;;
  stop)
    # shellcheck disable=SC2046
    systemctl --user stop $(units) && echo "stopped: $(units)"
    ;;
  restart)
    # shellcheck disable=SC2046
    systemctl --user restart $(units) && echo "restarted: $(units)"
    register_endpoint
    ;;
  status)
    for u in $(units); do
      systemctl --user --no-pager --lines=0 status "$u" 2>&1 | sed -n '1,4p' || true
      echo
    done
    if curl -fsS --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null; then
      echo   # health JSON printed above
    else
      echo "health: unreachable on :${PORT}"
    fi
    if oc_active; then
      # Ask relay what it thinks of the agent endpoint — a running opencode
      # process that relay can't authenticate against still reads as "up" to
      # systemd, and that distinction is the whole point of checking.
      # No backslashes in this snippet on purpose: escaping double quotes
      # inside a single-quoted bash string is not a thing, and doing it anyway
      # is how the first --list-models shipped broken. Plain %-formatting.
      curl -fsS --max-time 2 "http://127.0.0.1:${PORT}/admin/endpoints/health" 2>/dev/null \
        | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin).get("endpoints", [])
except Exception:
    sys.exit(0)
for r in rows:
    print("endpoint %s: %s (%s)" % (r["name"], r["health"], r.get("model") or "no model"))
' 2>/dev/null || true
    fi
    ;;
  logs)
    # shellcheck disable=SC2046
    journalctl --user $(for u in $(units); do printf -- '-u %s ' "$u"; done) -f
    ;;
  enable)
    loginctl enable-linger "$USER" 2>/dev/null || true
    # shellcheck disable=SC2046
    systemctl --user enable --now $(units) && echo "enabled on boot: $(units)"
    ;;
  disable)
    # shellcheck disable=SC2046
    systemctl --user disable --now $(units) && echo "disabled: $(units)"
    ;;
  -h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 2 ;;
esac
